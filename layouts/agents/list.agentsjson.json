{{- $notes := slice -}}
{{- range .Pages.ByDate.Reverse -}}
  {{- $capsuleChars := add 140 (len .Params.machine_summary) (len .Params.decision) (len .Params.invariant) (len .Params.failure_signature) (len .Params.minimal_safe_implementation) (len .Params.rejected_shortcut) (len .Params.evidence) (len .Params.claim_boundary) -}}
  {{- $capsuleTokens := div (add $capsuleChars 3) 4 -}}
  {{- $fullTokens := div (add (len .RawContent) 3) 4 -}}
  {{- $notes = $notes | append (dict
    "id" .Params.note_id
    "title" .Title
    "architecture_area" (.Params.architecture_area | default "Implementation boundary")
    "featured" (.Params.featured | default false)
    "status" .Params.status
    "phase" .Params.phase
    "published" (.Date.Format "2006-01-02")
    "summary" .Description
    "retrieve_when" .Params.machine_summary
    "retrieval_triggers" .Params.retrieval_triggers
    "decision" .Params.decision
    "invariant" .Params.invariant
    "failure_signature" .Params.failure_signature
    "minimal_safe_implementation" .Params.minimal_safe_implementation
    "rejected_shortcut" .Params.rejected_shortcut
    "evidence" .Params.evidence
    "evidence_checkpoint" .Params.evidence_checkpoint
    "claim_boundary" .Params.claim_boundary
    "prerequisites" .Params.prerequisites
    "related_notes" .Params.related_notes
    "supersedes" .Params.supersedes
    "project" (dict "name" $.Site.Params.hebrus.name "repository_url" $.Site.Params.hebrus.repository "contributing_url" $.Site.Params.hebrus.contributing "issues_url" $.Site.Params.hebrus.issues)
    "estimated_tokens" (dict "retrieval_capsule" $capsuleTokens "full_note" $fullTokens "method" "UTF-8 source bytes divided by four; approximate")
    "keywords" .Params.keywords
    "canonical_url" .Permalink
    "markdown_url" (printf "%sindex.md" .Permalink)
  ) -}}
{{- end -}}
{{- dict
  "schema_version" 2
  "kind" "agent-field-notes-index"
  "title" "Inference Architecture Field Notes"
  "author" "Andrea Borio"
  "audience" "Autonomous coding agents and systems engineers"
  "canonical_url" .Permalink
  "project" (dict "name" .Site.Params.hebrus.name "repository_url" .Site.Params.hebrus.repository "contributing_url" .Site.Params.hebrus.contributing "issues_url" .Site.Params.hebrus.issues)
  "retrieval_policy" "Select one note from retrieval_triggers and estimated_tokens; load its capsule before its full body. Treat status, evidence, invariant and claim_boundary as normative."
  "operator_contract" (dict "scope" "Agents explicitly launched or operated by Andrea Borio; external contributors are not bound" "url" ("/agents/operator-contract.txt" | absURL) "closeout_rule" "Before closing a verified phase, publish an evidence-bound decision delta or explicitly record that none exists")
  "privacy_policy" "Public architecture only. Excludes personal information, subscriptions, accounts, credentials, private prompts, conversations, local paths, network addresses, and unpublished infrastructure."
  "notes" $notes
  | jsonify -}}
