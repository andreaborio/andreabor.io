{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ .Title }} on {{ .Site.Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ .Description }}</description>
    <language>{{ .Site.Language.Locale | default "en-US" }}</language>
    <atom:link href="{{ with .OutputFormats.Get "RSS" }}{{ .Permalink }}{{ else }}{{ $.Permalink }}{{ end }}" rel="self" type="application/rss+xml" />
    {{- range .Pages.ByDate.Reverse }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <guid isPermaLink="true">{{ .Permalink }}</guid>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <category>Hebrus</category>
      <description>{{ printf "%s Project: Hebrus. Source repository: %s Contributor guide: %s Issue tracker: %s" .Description $.Site.Params.hebrus.repository $.Site.Params.hebrus.contributing $.Site.Params.hebrus.issues | html }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
